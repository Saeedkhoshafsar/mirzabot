# ============================================================================
#  Mirza Bot - environment variables
#  Copy to ".env" for local docker-compose, OR set these in the Coolify panel.
# ============================================================================

# ---- REQUIRED: the only 4 values you must enter manually -------------------
# Your server domain (no https://, no trailing slash). Telegram needs HTTPS,
# which Coolify/Traefik provides automatically.
BOT_DOMAIN=bot.example.com

# Telegram bot token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz

# Admin numeric Telegram ID (get it from @userinfobot)
ADMIN_CHAT_ID=123456789

# Bot username without the leading @
BOT_USERNAME=MyVpnBot

# ---- PANEL PROFILE: what this bot IS ----------------------------------------
# Decides which experience this container serves. One project, many products:
#   vpn     = VPN seller (legacy default)
#   shop    = online store  ← CURRENT DEVELOPMENT FOCUS
#   digital = digital goods (license/code/file)
#   channel = channel/subscription access
#   custom  = blank canvas (build with the flow editor)
# When set, the profile is LOCKED from inside the panel (ENV = single source
# of truth). The container optimizes itself for this mode on boot.
PANEL_MODE=shop

# ---- OPTIONAL: database (auto by default, no need to change) ----------------
DB_NAME=mirzabot
DB_USER=mirzabot
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_strong_root_password

# ---- OPTIONAL: Docker Image deploy (only for docker-compose.image.yml) ------
# The pre-built image published by the GitHub Action to GHCR.
# Replace with YOUR owner/repo (lowercase). Default points to this repo.
MIRZA_IMAGE=ghcr.io/saeedkhoshafsar/mirzabot:latest
