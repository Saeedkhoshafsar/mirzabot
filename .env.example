# ============================================================================
#  Mirza Bot - environment variables
#  Copy to ".env" for local docker-compose, OR set these in the Coolify panel.
# ============================================================================

# ---- REQUIRED: the only 4 values you must enter manually -------------------
# Your server domain (no https://, no trailing slash). Telegram needs HTTPS,
# which Coolify/Traefik provides automatically.
BOT_DOMAIN=bot.example.com

# Telegram bot token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz

# Admin numeric Telegram ID (get it from @userinfobot)
ADMIN_CHAT_ID=123456789

# Bot username without the leading @
BOT_USERNAME=MyVpnBot

# ---- OPTIONAL: database (auto by default, no need to change) ----------------
DB_NAME=mirzabot
DB_USER=mirzabot
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_strong_root_password
